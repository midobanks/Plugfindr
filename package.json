{
  "name": "plugfindr",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @plugfindr/web",
    "build": "npm run build --workspace @plugfindr/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:generate": "npm run db:generate --workspace @plugfindr/database",
    "db:migrate": "npm run db:migrate --workspace @plugfindr/database",
    "db:seed": "npm run db:seed --workspace @plugfindr/database"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
